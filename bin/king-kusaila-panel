#!/usr/bin/env python3
"""Cockpit King Kusaila (GTK3). Ouvert par l'avatar King dans Waybar.
- Répondeur Signal : bouton vert (actif) / rouge (coupé), clic = bascule.
- Missions background (Super+V) : ce que King fait/a fait + accès au rapport.
Ne se ferme qu'apres avoir eu le focus (corrige la fermeture instantanee), ou Esc."""
import gi, os, glob, subprocess
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib

HOME = os.path.expanduser("~")
ROOT = f"{HOME}/.king-kusaila"
STATE = f"{ROOT}/repondeur.state"
JOBS = f"{ROOT}/jobs"
BIN = f"{HOME}/.local/bin"


def repondeur_on():
    try:
        return open(STATE).read().strip() == "on"
    except OSError:
        return False


def bg_summary():
    """(nb missions en cours, libelle derniere mission, statut)."""
    try:
        running = int(subprocess.run(
            "pgrep -fc '[c]laude --print' || true", shell=True,
            capture_output=True, text=True).stdout.strip() or "0")
    except Exception:
        running = 0
    dirs = sorted(glob.glob(f"{JOBS}/*/"), key=os.path.getmtime, reverse=True)
    miss, stat = "", ""
    if dirs:
        try:
            for ln in open(f"{dirs[0]}/STATUS.md"):
                if ln.startswith("- mission:"):
                    miss = ln.split(":", 1)[1].strip()[:42]
                if ln.startswith("- status:") or ln.startswith("- exit_code:"):
                    stat = ln.split(":", 1)[1].strip()
        except OSError:
            pass
    return running, miss, stat


CSS = b"""
window { background-color: rgba(22,19,32,0.98); }
.title { color:#efeaff; font-weight:bold; font-size:14px; }
.sec   { color:#8f88ac; font-size:10px; font-weight:bold; }
.info  { color:#c8c2de; font-size:11px; }
button { margin:3px 10px; padding:9px 12px; border-radius:11px; border:0;
         background:#2b2742; color:#efeaff; font-size:12px; }
button:hover { background:#3a3556; }
.on  { background:#1f7a4d; color:#eafff3; } .on:hover  { background:#249059; }
.off { background:#7a2230; color:#ffe9ec; } .off:hover { background:#922a3a; }
"""


class Panel(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("King Kusaila Panel")
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_default_size(272, -1)
        self.set_keep_above(True)
        self._ready = False
        scr = self.get_screen()
        vis = scr.get_rgba_visual()
        if vis:
            self.set_visual(vis)
        self.set_app_paintable(True)
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(scr, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        box.set_margin_top(12)
        box.set_margin_bottom(12)
        self.add(box)

        t = Gtk.Label(label="\U0001F451  King Kusaila")
        t.get_style_context().add_class("title")
        box.pack_start(t, False, False, 4)

        self.btn_rep = Gtk.Button()
        self.btn_rep.connect("clicked", self.toggle_rep)
        box.pack_start(self.btn_rep, False, False, 0)

        sec = Gtk.Label(label="MISSIONS BACKGROUND (Super+V)", xalign=0)
        sec.get_style_context().add_class("sec")
        sec.set_margin_start(12)
        sec.set_margin_top(6)
        box.pack_start(sec, False, False, 0)

        self.lbl_bg = Gtk.Label(xalign=0)
        self.lbl_bg.get_style_context().add_class("info")
        self.lbl_bg.set_margin_start(12)
        self.lbl_bg.set_line_wrap(True)
        box.pack_start(self.lbl_bg, False, False, 0)

        b2 = Gtk.Button(label="\U0001F4CB  Statut & dernier rapport")
        b2.connect("clicked", self.open_status)
        box.pack_start(b2, False, False, 0)

        b3 = Gtk.Button(label="\U0001F4AC  Ouvrir Signal")
        b3.connect("clicked", lambda *_: self._run(["signal-desktop"]))
        box.pack_start(b3, False, False, 0)

        self.refresh()
        self.connect("key-press-event", self.on_key)
        self.connect("focus-in-event", self._on_focus_in)
        self.connect("focus-out-event", self._on_focus_out)

    # --- focus : ne fermer qu'apres avoir ete focus (sinon ferme instant) ---
    def _on_focus_in(self, *_):
        self._ready = True
        return False

    def _on_focus_out(self, *_):
        if self._ready:
            self.close()
        return False

    def refresh(self):
        on = repondeur_on()
        self.btn_rep.set_label(
            "\U0001F7E2  Repondeur Signal : ACTIF" if on else "\U0001F534  Repondeur Signal : coupe")
        ctx = self.btn_rep.get_style_context()
        ctx.remove_class("on")
        ctx.remove_class("off")
        ctx.add_class("on" if on else "off")
        running, miss, stat = bg_summary()
        if running:
            txt = f"\U0001F7E3 {running} en cours…"
        elif miss:
            txt = f"derniere : {miss} ({stat})"
        else:
            txt = "aucune mission"
        self.lbl_bg.set_text(txt)

    def _run(self, cmd):
        try:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass

    def toggle_rep(self, *_):
        self._run([f"{BIN}/king-repondeur", "toggle"])
        GLib.timeout_add(450, lambda: (self.refresh(), False)[1])

    def open_status(self, *_):
        self._run(["kitty", "--hold", "--title", "King Kusaila", "-e", f"{BIN}/king-kusaila-status"])
        self.close()

    def on_key(self, _w, e):
        if e.keyval == Gdk.KEY_Escape:
            self.close()


w = Panel()
w.connect("destroy", Gtk.main_quit)
w.show_all()
w.present()
Gtk.main()
