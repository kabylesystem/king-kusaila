#!/usr/bin/env bash
set -uo pipefail

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/naly-clipboard/thumbs"
SIZE="${NALY_CLIP_THUMB_SIZE:-160}"
MAX="${1:-60}"
mkdir -p "$CACHE"

ids="$(cliphist list 2>/dev/null | awk -F'\t' '/\[\[ binary data/ {print $1}' | head -n "$MAX")"
[[ -n "$ids" ]] || exit 0

printf '%s\n' "$ids" | nice -n 10 ionice -c3 xargs -P4 -I{} sh -c '
  out="'"$CACHE"'/{}.png"
  [ -s "$out" ] && exit 0
  tmp="$(mktemp "'"$CACHE"'/.{}.XXXX")"
  if cliphist decode {} 2>/dev/null | magick - -auto-orient -thumbnail '"$SIZE"'x'"$SIZE"' "$tmp.png" 2>/dev/null; then
    mv -f "$tmp.png" "$out"
  fi
  rm -f "$tmp" "$tmp.png"
'

keep="$(printf '%s\n' "$ids" | sed 's/$/.png/')"
find "$CACHE" -maxdepth 1 -name '*.png' -printf '%f\n' 2>/dev/null | while read -r f; do
  printf '%s\n' "$keep" | grep -qxF "$f" || rm -f "$CACHE/$f"
done
exit 0
