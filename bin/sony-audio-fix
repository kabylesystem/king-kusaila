#!/usr/bin/env bash
set -euo pipefail

internal_source="${KING_RECORD_SOURCE:-alsa_input.pci-0000_00_1f.3.analog-stereo}"

pactl list cards short 2>/dev/null |
  awk '$2 ~ /^bluez_card\./ { print $2 }' |
  while read -r card; do
    pactl set-card-profile "$card" a2dp-sink-aac >/dev/null 2>&1 ||
      pactl set-card-profile "$card" a2dp-sink-sbc_xq >/dev/null 2>&1 ||
      pactl set-card-profile "$card" a2dp-sink >/dev/null 2>&1 ||
      true
  done

sink=""
for _ in {1..15}; do
  sink="$(pactl list sinks short 2>/dev/null | awk '$2 ~ /^bluez_output\./ { print $2; exit }')"
  [[ -n "$sink" ]] && break
  sleep 0.2
done

if [[ -n "$sink" ]]; then
  pactl set-default-sink "$sink" >/dev/null 2>&1 || true
  pactl list sink-inputs short 2>/dev/null |
    awk '{ print $1 }' |
    while read -r input; do
      pactl move-sink-input "$input" "$sink" >/dev/null 2>&1 || true
    done
fi

pactl set-default-source "$internal_source" >/dev/null 2>&1 || true

printf 'sink=%s\n' "${sink:-none}"
printf 'source=%s\n' "$(pactl get-default-source 2>/dev/null || true)"
pactl list cards 2>/dev/null |
  sed -n '/bluez_card\./,/Ports:/p' |
  grep -E 'Name:|Active Profile:' || true
