#!/usr/bin/env bash
set -euo pipefail

CONFIG="$HOME/.config/king-kusaila/openai.env"

if [[ -f "$CONFIG" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    [[ "$line" == *=* ]] || continue
    key="${line%%=*}"
    val="${line#*=}"
    key="${key//[[:space:]]/}"
    val="${val#"${val%%[![:space:]]*}"}"
    val="${val%"${val##*[![:space:]]}"}"
    val="${val#\"}"; val="${val%\"}"
    val="${val#\'}"; val="${val%\'}"
    [[ -n "$key" ]] || continue
    [[ -n "${!key:-}" ]] && continue
    export "$key=$val"
  done < "$CONFIG"
fi

BACKEND="${KING_TRANSCRIBE_BACKEND:-openai}"
OPENAI_MODEL="${KING_OPENAI_TRANSCRIBE_MODEL:-gpt-4o-transcribe}"
export KING_OPENAI_TRANSCRIBE_MODEL="$OPENAI_MODEL"

if [[ $# -lt 1 ]]; then
  echo "usage: voice-transcribe <audio-file>" >&2
  exit 2
fi

audio="$1"
original_audio="$1"

KING_TRANSCRIBE_LANG="${KING_TRANSCRIBE_LANG:-fr}"
export KING_TRANSCRIBE_LANG

PREP="$HOME/.local/bin/voice-audio-prep"
LOG="${KING_TRANSCRIBE_LOG:-${audio%.*}.prep.json}"
asr_input="$audio"

if [[ -f "$audio" && -x "$PREP" ]]; then
  clean="${audio%.*}.clean.wav"
  if metrics="$("$PREP" "$audio" "$clean" 2>/dev/null)" && [[ -n "$metrics" ]]; then
    printf '%s\n' "$metrics" > "$LOG" 2>/dev/null || true
    verdict="$(jq -r '.verdict // "unknown"' <<<"$metrics" 2>/dev/null || echo unknown)"
    case "$verdict" in
      speech) asr_input="$clean" ;;
      clipped)
        echo "voice-transcribe: micro sature ($(jq -r '.clipped_pct' <<<"$metrics")% ecrete) -> gain d'entree trop haut" >&2
        exit 0 ;;
      silence|short) exit 0 ;;
      *) asr_input="$audio" ;;
    esac
  fi
fi

audio="$asr_input"

# ---- Backends ----------------------------------------------------------------
BACKEND_FILE="${original_audio%.*}.backend"
note_backend() { printf '%s\n' "$1" > "$BACKEND_FILE" 2>/dev/null || true; }

transcribe() {
  if [[ "$BACKEND" == "local" ]]; then
    note_backend "whisper local (KING_TRANSCRIBE_BACKEND=local)"
    "$HOME/.local/bin/voice-transcribe-local" "$audio"
    return
  fi
  if [[ -z "${OPENAI_API_KEY:-}" ]]; then
    echo "voice-transcribe: OPENAI_API_KEY absente de ~/.config/king-kusaila/openai.env" >&2
    note_backend "whisper local (pas de cle OpenAI)"
    "$HOME/.local/bin/voice-transcribe-local" "$audio"
    return
  fi
  local text err
  err="$(mktemp)"
  if text="$("$HOME/.local/bin/voice-transcribe-openai" "$audio" 2>"$err")" && [[ -n "${text//[[:space:]]/}" ]]; then
    note_backend "$OPENAI_MODEL"
    rm -f "$err"
    printf '%s\n' "$text"
    return
  fi
  echo "voice-transcribe: $OPENAI_MODEL a echoue -> repli whisper local. Cause: $(tr '\n' ' ' < "$err")" >&2
  note_backend "whisper local (repli, $OPENAI_MODEL a echoue: $(tr '\n' ' ' < "$err" | cut -c1-200))"
  rm -f "$err"
  "$HOME/.local/bin/voice-transcribe-local" "$audio"
}

raw="$(transcribe || true)"

# ---- Gate langue: naly ne parle QUE français/anglais --------------------------
# whisper.cpp (--language auto) et l'API OpenAI detectent parmi ~99 langues et
# hallucinent parfois du texte dans une langue totalement etrangere (coreen,
# arabe, cyrillique...) sur un clip court/ambigu. Ni whisper.cpp ni l'API n'ont
# de flag "limite a un sous-ensemble de langues" -> on filtre le RESULTAT: si
# une part significative des lettres n'est pas latine (fr/en/accents), c'est
# une hallucination de langue -> rejet, comme le silence (rien tape > du charabia).
if [[ -n "${raw//[[:space:]]/}" ]] && command -v python3 >/dev/null 2>&1; then
  if ! printf '%s' "$raw" | python3 -c '
import sys, unicodedata
text = sys.stdin.read()
letters = [c for c in text if c.isalpha()]
if not letters:
    sys.exit(0)
def is_latin(c):
    try:
        return "LATIN" in unicodedata.name(c)
    except ValueError:
        return False
foreign = sum(1 for c in letters if not is_latin(c))
sys.exit(1 if foreign / len(letters) > 0.15 else 0)
'; then
    exit 0   # langue hors fr/en detectee -> rien tape
  fi
fi

# ---- Filtre final: artefacts d'hallucination connus --------------------------
# Tue uniquement si TOUTE la sortie == un artefact connu (insensible casse).
# Inoffensif pour la vraie dictee: personne ne dicte exactement ces phrases.
norm="$(printf '%s' "$raw" \
        | tr '[:upper:]' '[:lower:]' \
        | sed -E "s/^[[:space:]]+//; s/[[:space:]]+\$//; s/[[:space:]]+/ /g")"
case "$norm" in
  "sous-titres réalisés par la communauté d'amara.org"|\
  "sous-titres réalisés par l'amara.org"|\
  "sous-titrage société radio-canada"|\
  "merci d'avoir regardé cette vidéo"|\
  "merci d'avoir regardé cette vidéo !"|\
  "merci d'avoir regardé"|\
  "merci."|\
  "thank you for watching"|\
  "thanks for watching"|\
  "thank you."|\
  "you"|\
  "..."|"."|"♪"|"♪♪"|"[musique]"|"[music]")
    exit 0 ;;
  "("*")"|"["*"]")
    exit 0 ;;
esac

[[ -n "${raw//[[:space:]]/}" ]] && printf '%s\n' "$raw"
exit 0
