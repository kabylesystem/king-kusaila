#!/usr/bin/env bash
set -uo pipefail

CTRL=/sys/bus/pci/devices/0000:00:1f.3/power/runtime_status
SINK="$(pactl list sinks short | awk '$2 ~ /^alsa_output\./ {print $2; exit}')"
SRC="$(pactl list sources short | awk '$2 ~ /^alsa_input\./ {print $2; exit}')"
DIR="$(mktemp -d)"
trap 'rm -rf "$DIR"' EXIT

python3 - "$DIR/tone.wav" <<'PY'
import wave, struct, math, sys
r = 48000
w = wave.open(sys.argv[1], 'wb'); w.setnchannels(1); w.setsampwidth(2); w.setframerate(r)
w.writeframes(b''.join(struct.pack('<h', int(12000*math.sin(2*math.pi*880*i/r))) for i in range(r*2)))
w.close()
PY

cycle() {
  pw-record --target "$SRC" --rate 16000 --channels 1 --format s16 "$DIR/cap.wav" >/dev/null 2>&1 & local p=$!
  sleep 0.4
  pw-play --target "$SINK" "$DIR/tone.wav"
  sleep 0.4
  kill -INT "$p" 2>/dev/null; wait "$p" 2>/dev/null
  python3 - "$DIR/cap.wav" <<'PY'
import wave, struct, math, sys
w = wave.open(sys.argv[1]); n = w.getnframes()
s = struct.unpack('<%dh' % n, w.readframes(n))
rms = math.sqrt(sum(x*x for x in s)/max(n, 1))
print('CAPTE' if rms > 3000 else 'MORT', f'(rms={rms:.0f})')
PY
}

echo "kernel: $(uname -r) · power_save=$(cat /sys/module/snd_hda_intel/parameters/power_save)"
printf 'attente suspend du controleur HDA... '
for _ in $(seq 1 40); do [ "$(cat "$CTRL")" = suspended ] && break; sleep 1; done
echo "[$(cat "$CTRL")]"

printf 'cycle 1 (sortie de suspend) : '
r1="$(cycle)"
echo "$r1"
sleep 1
printf 'cycle 2 (controleur actif)  : '
r2="$(cycle)"
echo "$r2"

case "$r1|$r2" in
  CAPTE*"|"CAPTE*) echo "VERDICT: micro SAIN, bug kernel absent ou corrige" ;;
  CAPTE*"|"MORT*)  echo "VERDICT: bug kernel TOUJOURS LA (routes mortes apres fermeture de stream) · garder power_save=1, tester un kernel plus recent ou le LTS" ;;
  *)               echo "VERDICT: micro totalement muet, probleme plus profond (source, volume, materiel)" ;;
esac
