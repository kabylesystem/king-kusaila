#!/usr/bin/env bash
set -euo pipefail

# large-v3-turbo quantifie q5_0 : mesure le 2026-08-29 sur une dictee de 29 s,
# 8,6 s contre 6,9 s pour base et 12,9 s pour small. Le turbo a moins de couches
# de decodage, il bat donc small en vitesse ET en qualite. 1,7 s de plus que base
# pour passer du pire au meilleur modele : le repli local vaut enfin l API.
MODEL="${KING_WHISPER_MODEL:-$HOME/.local/share/whisper.cpp/models/ggml-large-v3-turbo-q5_0.bin}"
if [[ ! -f "$MODEL" ]]; then
  MODEL="$HOME/.local/share/whisper.cpp/models/ggml-base.bin"
fi

if [[ $# -lt 1 ]]; then
  echo "usage: voice-transcribe <audio.wav>" >&2
  exit 2
fi

audio="$1"
if [[ ! -f "$audio" ]]; then
  echo "voice-transcribe: audio file not found: $audio" >&2
  exit 1
fi
if [[ ! -f "$MODEL" ]]; then
  echo "voice-transcribe: model file not found: $MODEL" >&2
  exit 1
fi

base="${audio%.*}"
out="$base.txt"
log="$base.whisper.log"

whisper-cli \
  --model "$MODEL" \
  --file "$audio" \
  --language "${KING_TRANSCRIBE_LANG:-fr}" \
  --no-timestamps \
  --output-txt \
  --output-file "$base" \
  --threads "${KING_WHISPER_THREADS:-8}" \
  >"$log" 2>&1

if [[ ! -f "$out" ]]; then
  echo "voice-transcribe: whisper produced no text file; log: $log" >&2
  exit 1
fi

sed \
  -e 's/\[BLANK_AUDIO\]//g' \
  -e 's/^[[:space:]]*//' \
  -e 's/[[:space:]]*$//' \
  "$out" | awk 'NF {print}'
