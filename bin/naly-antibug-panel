PAGE_SIZE = os.sysconf("SC_PAGE_SIZE")
CPU_COUNT = os.cpu_count() or 1
CURRENT_UID = os.getuid()
PROTECTED = re.compile(
    r"Hyprland|waybar|pipewire|wireplumber|quickshell|systemd|dbus|kitty|"
    r"claude|codex|sway|hypr|Xwayland|gnome-keyring|polkit|udev|"
    r"thermal-recorder|naly-antibug"
)


