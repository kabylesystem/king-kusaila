def human_bytes(value):
    if value >= 1024 ** 3:
        return f"{value / 1024 ** 3:.1f} GB"
    return f"{value / 1024 ** 2:.0f} MB"


def read_temperature():
    for hwmon in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            with open(os.path.join(hwmon, "name"), encoding="utf-8") as handle:
                if handle.read().strip() != "coretemp":
                    continue
            with open(os.path.join(hwmon, "temp1_input"), encoding="utf-8") as handle:
                return int(handle.read().strip()) // 1000
        except (OSError, ValueError):
            pass
    return 0


def memory_usage():
    values = {}
    try:
        with open("/proc/meminfo", encoding="utf-8") as handle:
            for line in handle:
                key, value = line.split(":", 1)
                values[key] = int(value.split()[0]) * 1024
    except (OSError, ValueError):
        return 0, 0
    total = values.get("MemTotal", 0)
    used = total - values.get("MemAvailable", 0)
    return used, total


def audio_pids():
    try:
        output = subprocess.run(
            ["pactl", "list", "sink-inputs"],
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        ).stdout
    except Exception:
        return set()
    return {int(pid) for pid in re.findall(r'application\.process\.id = "(\d+)"', output)}


def total_cpu_ticks():
    try:
        with open("/proc/stat", encoding="utf-8") as handle:
            return sum(int(value) for value in handle.readline().split()[1:])
    except (OSError, ValueError):
        return 0


def collect_processes():
    rows = {}
    uptime = float(open("/proc/uptime", encoding="utf-8").read().split()[0])
    for path in glob.glob("/proc/[0-9]*/stat"):
        pid = int(path.split("/")[2])
        try:
            raw = open(path, encoding="utf-8").read()
            end = raw.rindex(")")
            name = raw[raw.index("(") + 1:end]
            fields = raw[end + 2:].split()
            start_ticks = int(fields[19])
            proc_ticks = int(fields[11]) + int(fields[12])
            state = fields[0]
            rss_pages = int(open(f"/proc/{pid}/statm", encoding="utf-8").read().split()[1])
            command = open(f"/proc/{pid}/cmdline", "rb").read().replace(b"\0", b" ").decode(errors="replace").strip()
            owner = os.stat(f"/proc/{pid}").st_uid
        except (OSError, ValueError, IndexError):
            continue
        rows[pid] = {
            "pid": pid,
            "name": name,
            "command": command or f"[{name}]",
            "ticks": proc_ticks,
            "start_ticks": start_ticks,
            "state": state,
            "rss": rss_pages * PAGE_SIZE,
            "age": max(0, uptime - start_ticks / HZ),
            "mine": owner == CURRENT_UID,
            "protected": bool(PROTECTED.search(name) or PROTECTED.search(command)),
        }
    return rows, total_cpu_ticks()


class ProcessRow(Gtk.ListBoxRow):
    def __init__(self, window, process):
        super().__init__()
        self.window = window
        self.process = process
        self.popover = None
        self.add_css_class("process-row")

        line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        name = Gtk.Label(label=process["name"], xalign=0)
        name.add_css_class("process-name")
        name.set_width_chars(18)
        name.set_max_width_chars(18)
        name.set_ellipsize(Pango.EllipsizeMode.END)

        command = Gtk.Label(label=process["command"], xalign=0)
        command.add_css_class("process-command")
        command.set_hexpand(True)
        command.set_ellipsize(Pango.EllipsizeMode.END)

        pid = Gtk.Label(label=str(process["pid"]), xalign=1)
        pid.set_width_chars(7)
        cpu = Gtk.Label(label=f'{process["cpu"]:.1f}%', xalign=1)
        cpu.set_width_chars(7)
        if process["cpu"] >= 40:
            cpu.add_css_class("hot")
        ram = Gtk.Label(label=human_bytes(process["rss"]), xalign=1)
        ram.set_width_chars(9)

        for widget in (name, command, pid, cpu, ram):
            line.append(widget)
        self.set_child(line)

        right_click = Gtk.GestureClick()
        right_click.set_button(3)
        right_click.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        right_click.connect("pressed", self.on_right_click)
        self.add_controller(right_click)

    def on_right_click(self, _gesture, _presses, x, y):
        parent = self.get_parent()
        if isinstance(parent, Gtk.ListBox):
            parent.select_row(self)
        self.show_context_menu(x, y)

    def show_context_menu(self, x, y):
        if self.popover:
            self.popover.unparent()
        self.popover = Gtk.Popover()
        self.popover.set_parent(self)
        point = Gdk.Rectangle()
        point.x, point.y, point.width, point.height = int(x), int(y), 1, 1
        self.popover.set_pointing_to(point)

        menu = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        menu.add_css_class("context-menu")
        process = self.process
        allowed = process["mine"] and not process["protected"]
        playing = process["pid"] in self.window.playing_audio

        if not allowed:
            reason = "Protected system process" if process["protected"] else "Owned by another user"
            label = Gtk.Label(label=reason, xalign=0)
            label.add_css_class("muted")
            label.set_margin_start(8)
            label.set_margin_end(8)
            label.set_margin_top(5)
            label.set_margin_bottom(5)
            menu.append(label)

        actions = [
            ("Freeze", signal.SIGSTOP, allowed and not playing and process["state"] != "T", False),
            ("Resume", signal.SIGCONT, allowed and process["state"] == "T", False),
            ("Close", signal.SIGTERM, allowed, False),
            ("Force close", signal.SIGKILL, allowed, True),
        ]
        for label, sig, sensitive, force in actions:
            button = Gtk.Button(label=label)
            button.add_css_class("soft-button")
            if force:
                button.add_css_class("danger")
            button.set_sensitive(sensitive)
            button.connect("clicked", self.on_action, sig, force)
            menu.append(button)

        self.popover.set_child(menu)
        self.popover.popup()

    def on_action(self, _button, sig, force):
        if self.popover:
            self.popover.popdown()
        if force:
            self.window.confirm_force_close(self.process)
        else:
            self.window.signal_process(self.process, sig)


class AntibugWindow(Gtk.ApplicationWindow):
    def __init__(self, application):
        super().__init__(application=application, title="Anti-bug")
        self.set_default_size(1080, 760)
        self.set_size_request(820, 580)
        self.previous = {}
        self.previous_total = 0
        self.processes = []
        self.sort_mode = "cpu"
        self.scan_process = None
        self.playing_audio = set()

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        root.add_css_class("root")
        self.set_child(root)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        icon = Gtk.Image.new_from_icon_name("utilities-system-monitor-symbolic")
        icon.set_pixel_size(30)
        titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        title = Gtk.Label(label="Anti-bug", xalign=0)
        title.add_css_class("title")
        subtitle = Gtk.Label(label="Find the cause. Take action.", xalign=0)
        subtitle.add_css_class("subtitle")
        titles.append(title)
        titles.append(subtitle)
        self.health = Gtk.Label(label="SCANNING")
        self.health.add_css_class("health")
        self.scan_button = Gtk.Button(label="Re-scan")
        self.scan_button.add_css_class("primary")
        self.scan_button.connect("clicked", lambda _button: self.start_scan())
        header.append(icon)
        header.append(titles)
        titles.set_hexpand(True)
        header.append(self.health)
        header.append(self.scan_button)
        root.append(header)

        metrics = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, homogeneous=True, spacing=24)
        self.temp_value = self.metric(metrics, "TEMPERATURE")
        self.cpu_value = self.metric(metrics, "CPU NOW")
        self.ram_value = self.metric(metrics, "RAM USED")
        root.append(metrics)

        recommendation = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        recommendation.add_css_class("recommendation")
        rec_header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        rec_title = Gtk.Label(label="Recommended now", xalign=0)
        rec_title.add_css_class("section-title")
        rec_title.set_hexpand(True)
        self.scan_spinner = Gtk.Spinner()
        rec_header.append(rec_title)
        rec_header.append(self.scan_spinner)
        recommendation.append(rec_header)
        self.recommendation_text = Gtk.Label(label="Checking the machine…", xalign=0)
        self.recommendation_text.add_css_class("recommendation-text")
        self.recommendation_text.set_wrap(True)
        self.recommendation_text.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
        recommendation.append(self.recommendation_text)
        self.recommendation_actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        recommendation.append(self.recommendation_actions)
        root.append(recommendation)

        process_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        process_title = Gtk.Label(label="Processes", xalign=0)
        process_title.add_css_class("section-title")
        process_title.set_hexpand(True)
        self.search = Gtk.SearchEntry(placeholder_text="Find an app")
        self.search.set_width_chars(20)
        self.search.connect("search-changed", lambda _entry: self.rebuild_rows())
        self.cpu_sort = Gtk.Button(label="CPU")
        self.cpu_sort.add_css_class("soft-button")
        self.cpu_sort.add_css_class("active-sort")
        self.cpu_sort.connect("clicked", self.on_sort, "cpu")
        self.ram_sort = Gtk.Button(label="RAM")
        self.ram_sort.add_css_class("soft-button")
        self.ram_sort.connect("clicked", self.on_sort, "ram")
        process_bar.append(process_title)
        process_bar.append(self.search)
        process_bar.append(self.cpu_sort)
        process_bar.append(self.ram_sort)
        root.append(process_bar)

        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        frame.add_css_class("process-frame")
        columns = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        columns.add_css_class("process-header")
        for label, width, expand in (
            ("APP", 18, False),
            ("COMMAND", -1, True),
            ("PID", 7, False),
            ("CPU", 7, False),
            ("RAM", 9, False),
        ):
            item = Gtk.Label(label=label, xalign=0 if expand or label == "APP" else 1)
            item.set_hexpand(expand)
            if width > 0:
                item.set_width_chars(width)
            columns.append(item)
        frame.append(columns)
        self.process_list = Gtk.ListBox()
        self.process_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_child(self.process_list)
        frame.append(scroll)
        root.append(frame)
        frame.set_vexpand(True)

        self.status = Gtk.Label(label="Right-click a process for actions.", xalign=0)
        self.status.add_css_class("status")
        root.append(self.status)

        self.previous, self.previous_total = collect_processes()
        GLib.timeout_add(900, self.refresh_processes_once)
        GLib.timeout_add(4000, self.refresh_processes)
        GLib.idle_add(self.start_scan)

    @staticmethod
    def metric(parent, title):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        value = Gtk.Label(label="…", xalign=0)
        value.add_css_class("metric-value")
        label = Gtk.Label(label=title, xalign=0)
        label.add_css_class("metric-label")
        box.append(value)
        box.append(label)
        parent.append(box)
        return value

    def on_sort(self, button, mode):
        self.cpu_sort.remove_css_class("active-sort")
        self.ram_sort.remove_css_class("active-sort")
        button.add_css_class("active-sort")
        self.sort_mode = mode
        self.rebuild_rows()

    def refresh_processes(self):
        current, total = collect_processes()
        total_delta = max(1, total - self.previous_total)
        for pid, process in current.items():
            old = self.previous.get(pid)
            if old and old["start_ticks"] == process["start_ticks"]:
                process["cpu"] = max(0.0, (process["ticks"] - old["ticks"]) / total_delta * CPU_COUNT * 100)
            else:
                process["cpu"] = 0.0
        self.previous, self.previous_total = current, total
        self.processes = list(current.values())
        self.playing_audio = audio_pids()

        temperature = read_temperature()
        used, total_memory = memory_usage()
        total_cpu = sum(process["cpu"] for process in self.processes)
        self.temp_value.set_text(f"{temperature}°C" if temperature else "Unknown")
        self.cpu_value.set_text(f"{total_cpu / CPU_COUNT:.0f}%")
        self.ram_value.set_text(f"{human_bytes(used)} / {human_bytes(total_memory)}")
        self.rebuild_rows()
        return True

    def rebuild_rows(self):
        while child := self.process_list.get_first_child():
            self.process_list.remove(child)
        query = self.search.get_text().strip().lower()
        rows = self.processes
        if query:
            rows = [row for row in rows if query in row["name"].lower() or query in row["command"].lower()]
        key = "cpu" if self.sort_mode == "cpu" else "rss"
        rows = sorted(rows, key=lambda row: row[key], reverse=True)[:50]
        for process in rows:
            self.process_list.append(ProcessRow(self, process))

    def start_scan(self):
        if self.scan_process and self.scan_process.poll() is None:
            return False
        os.makedirs(STATE_DIR, exist_ok=True)
        self.scan_button.set_sensitive(False)
        self.health.set_text("SCANNING")
        self.health.remove_css_class("attention")
        self.scan_spinner.start()
        self.recommendation_text.set_text("Checking CPU, RAM, old processes, duplicates, disk pressure and services…")
        self.clear_recommendation_actions()
        self.add_calm_button()
        try:
            self.scan_process = subprocess.Popen(
                [SCANNER, "--panel"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except OSError as error:
            self.scan_process = None
            self.finish_scan_error(str(error))
            return False
        GLib.timeout_add(250, self.poll_scan)
        return False

    def poll_scan(self):
        if self.scan_process and self.scan_process.poll() is None:
            return True
        self.scan_spinner.stop()
        self.scan_button.set_sensitive(True)
        try:
            with open(JSON_REPORT, encoding="utf-8") as handle:
                report = json.load(handle)
        except (OSError, ValueError) as error:
            self.finish_scan_error(str(error))
            return False
        self.show_report(report)
        return False

    def finish_scan_error(self, detail):
        self.scan_spinner.stop()
        self.scan_button.set_sensitive(True)
        self.health.set_text("SCAN FAILED")
        self.health.add_css_class("attention")
        self.recommendation_text.set_text(f"The scan could not finish. {detail}")

    def clear_recommendation_actions(self):
        while child := self.recommendation_actions.get_first_child():
            self.recommendation_actions.remove(child)

    def add_calm_button(self):
        button = Gtk.Button(label="Calm PC now")
        button.add_css_class("primary")
        button.connect("clicked", self.calm_pc_now)
        self.recommendation_actions.append(button)

    def eligible_processes(self, minimum_cpu=15):
        return [
            process for process in sorted(
                self.processes, key=lambda item: item["cpu"], reverse=True
            )
            if process["mine"]
            and not process["protected"]
            and process["pid"] not in self.playing_audio
            and process["cpu"] >= minimum_cpu
        ]

    def calm_process(self, _button, process):
        try:
            raw = open(f'/proc/{process["pid"]}/stat', encoding="utf-8").read()
            fields = raw[raw.rindex(")") + 2:].split()
            if int(fields[19]) != process["start_ticks"]:
                raise ProcessLookupError("PID was reused")
            os.setpriority(os.PRIO_PROCESS, process["pid"], 19)
            subprocess.run(
                ["ionice", "-c3", "-p", str(process["pid"])],
                capture_output=True,
                timeout=2,
                check=False,
            )
        except (OSError, ValueError, IndexError, subprocess.SubprocessError) as error:
            self.status.set_text(f'Could not calm {process["name"]}: {error}')
            return
        self.status.set_text(f'{process["name"]} now has low CPU and disk priority.')

    def calm_pc_now(self, _button):
        try:
            profile = subprocess.run(
                ["sudo", "-n", "/usr/local/bin/naly-thermal-profile", "silencieux"],
                capture_output=True,
                text=True,
                timeout=4,
                check=False,
            )
            profile_applied = profile.returncode == 0
        except (OSError, subprocess.SubprocessError):
            profile_applied = False
        targets = self.eligible_processes()[:6]
        for process in targets:
            self.calm_process(None, process)
        names = ", ".join(dict.fromkeys(process["name"] for process in targets))
        actions = ["Silent thermal profile"] if profile_applied else []
        if names:
            actions.append(f"low priority: {names}")
        self.recommendation_text.set_text(
            "Applied now:\n• " + "\n• ".join(actions or ["no unsafe process was touched"])
        )
        self.health.set_text("COOLING")
        self.health.remove_css_class("attention")
        self.status.set_text("Cooling applied. Re-checking the machine…")
        GLib.timeout_add(1200, self.start_scan)

    def show_report(self, report):
        self.clear_recommendation_actions()
        self.add_calm_button()
        fixed = report.get("fixed") or []
        found = report.get("found") or []
        if fixed:
            lines = ["Fixed automatically:"] + [f"• {item}" for item in fixed]
        elif found:
            lines = ["Needs attention:"] + [f"• {item}" for item in found[:4]]
        else:
            lines = ["Nothing unusual right now. The machine looks healthy."]
        self.recommendation_text.set_text("\n".join(lines))
        needs_attention = bool(found)
        self.health.set_text("CHECK THIS" if needs_attention else "CALM")
        if needs_attention:
            self.health.add_css_class("attention")
        else:
            self.health.remove_css_class("attention")

        offer = report.get("offer")
        if offer:
            kind = offer.get("kind")
            label = {
                "freeze": f'Freeze {offer.get("name", "process")}',
                "kill": f'Close {offer.get("name", "process")}',
                "sweep": f'Close {len(offer.get("pids") or [])} old copies',
            }.get(kind, "Apply")
            button = Gtk.Button(label=label)
            button.add_css_class("soft-button")
            button.connect("clicked", self.apply_offer, offer)
            self.recommendation_actions.append(button)
        for process in self.eligible_processes()[:2]:
            button = Gtk.Button(label=f'Calm {process["name"]}')
            button.add_css_class("soft-button")
            button.connect("clicked", self.calm_process, process)
            self.recommendation_actions.append(button)
        hint = Gtk.Label(label="Right-click any process below for more actions.", xalign=0)
        hint.add_css_class("muted")
        self.recommendation_actions.append(hint)

    def apply_offer(self, _button, offer):
        kind = offer.get("kind")
        sig = signal.SIGSTOP if kind == "freeze" else signal.SIGTERM
        done = 0
        for pid in offer.get("pids") or []:
            try:
                os.kill(int(pid), sig)
                done += 1
            except OSError:
                pass
        self.status.set_text(f"Action applied to {done} process(es).")
        GLib.timeout_add(1200, self.start_scan)

    def signal_process(self, process, sig):
        pid = process["pid"]
        try:
            raw = open(f"/proc/{pid}/stat", encoding="utf-8").read()
            fields = raw[raw.rindex(")") + 2:].split()
            if int(fields[19]) != process["start_ticks"]:
                raise ProcessLookupError("PID was reused")
            os.kill(pid, sig)
        except (OSError, ValueError, IndexError) as error:
            self.status.set_text(f"Could not act on {process['name']}: {error}")
            return
        verbs = {
            signal.SIGSTOP: "frozen",
            signal.SIGCONT: "resumed",
            signal.SIGTERM: "asked to close",
            signal.SIGKILL: "force closed",
        }
        self.status.set_text(f"{process['name']} was {verbs[sig]}.")
        GLib.timeout_add(500, self.refresh_processes_once)

    def refresh_processes_once(self):
        self.refresh_processes()
        return False

    def confirm_force_close(self, process):
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.CANCEL,
            text=f"Force close {process['name']}?",
        )
        dialog.format_secondary_text("Unsaved work in this process can be lost.")
        dialog.add_button("Force close", Gtk.ResponseType.ACCEPT)
        dialog.connect("response", self.on_force_close_response, process)
        dialog.present()

    def on_force_close_response(self, dialog, response, process):
        dialog.destroy()
        if response == Gtk.ResponseType.ACCEPT:
            self.signal_process(process, signal.SIGKILL)


class AntibugApplication(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.window = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        display = Gdk.Display.get_default()
        if display:
            Gtk.StyleContext.add_provider_for_display(
                display, provider, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1
            )

    def do_activate(self):
        if not self.window:
            self.window = AntibugWindow(self)
        self.window.present()


def open_history():
    subprocess.Popen(
        [
            "kitty",
            "--class", "naly-antibug-history",
            "--title", "Anti-bug: Thermal history",
            "-o", "confirm_os_window_close=0",
            "-e", "sh", "-c",
            '$HOME/.local/bin/pc-furie 12; printf "\\nPress Enter to close"; read -r _',
        ],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


if __name__ == "__main__":
    if "--history" in sys.argv:
        open_history()
        raise SystemExit(0)
    try:
        os.setpriority(os.PRIO_PROCESS, 0, 10)
    except OSError:
        pass
    raise SystemExit(AntibugApplication().run([sys.argv[0]]))
