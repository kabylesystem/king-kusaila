#!/usr/bin/env python3
import json
import math
import struct
import subprocess
import sys
import wave
from pathlib import Path

import os

RAIL = 32700
TARGET_RMS_DB = -20.0
PEAK_CEILING_DB = -1.0
MAX_GAIN_DB = 30.0
MAX_TRIM_SEC = 1.5
WIN_SEC = 0.025
HEAD_CLIP_FRACTION = 0.5
HEAD_QUIET_DB = -24.0

MIN_DUR = float(os.environ.get("KING_MIN_AUDIO_SEC", "0.35"))
MIN_PEAK_DB = float(os.environ.get("KING_MIN_PEAK_DB", "-34"))
MIN_SNR_DB = float(os.environ.get("KING_MIN_SNR_DB", "8"))
LOUD_ENOUGH_DB = float(os.environ.get("KING_LOUD_ENOUGH_DB", "-30"))
MAX_CLIP_PCT = float(os.environ.get("KING_MAX_CLIP_PCT", "20"))
LOUD_WIN_SEC = 0.3
LOUD_HOP_SEC = 0.1
FLOOR_WIN_SEC = 0.1
FLOOR_HOP_SEC = 0.05
FLOOR_PERCENTILE = 0.10


def db(x):
    return 20 * math.log10(max(x, 1e-9) / 32768.0)


def snr_of(samples, rate):
    loud, floor = loud_and_floor_db(samples, rate)
    return loud - floor


def pick_best_channel(samples, channels, rate):
    if channels < 2:
        return samples, 0
    lanes = [samples[c::channels] for c in range(channels)]
    scored = [(snr_of(lane, rate), idx) for idx, lane in enumerate(lanes)]
    best_snr, best_idx = max(scored)
    return lanes[best_idx], best_idx


def load(path):
    try:
        with wave.open(str(path)) as w:
            if w.getsampwidth() != 2:
                raise ValueError("not s16")
            rate = w.getframerate()
            channels = w.getnchannels()
            frames = w.getnframes()
            raw = w.readframes(frames)
        samples = list(struct.unpack("<%dh" % (len(raw) // 2), raw))
        samples, channel = pick_best_channel(samples, channels, rate)
        return samples, rate, channel
    except Exception:
        pass
    try:
        out = subprocess.run(
            ["ffmpeg", "-hide_banner", "-loglevel", "error", "-i", str(path),
             "-ac", "1", "-ar", "16000", "-f", "s16le", "-"],
            capture_output=True, timeout=60, check=True).stdout
        return list(struct.unpack("<%dh" % (len(out) // 2), out)), 16000, 0
    except Exception:
        return None, None, 0


def trim_wakeup_pop(samples, rate):
    win = max(1, int(WIN_SEC * rate))
    head = samples[:win]
    if not head:
        return samples, 0
    railed = sum(1 for v in head if abs(v) >= RAIL) / len(head)
    if railed < HEAD_CLIP_FRACTION:
        return samples, 0
    limit = min(len(samples), int(MAX_TRIM_SEC * rate))
    for start in range(0, limit - win, win):
        chunk = samples[start : start + win]
        if any(abs(v) >= RAIL for v in chunk):
            continue
        if db(max(abs(v) for v in chunk)) < HEAD_QUIET_DB:
            return samples[start:], start
    return samples[limit:], limit


def window_rms_profile(samples, rate, win_sec=LOUD_WIN_SEC, hop_sec=LOUD_HOP_SEC):
    win = max(1, int(win_sec * rate))
    hop = max(1, int(hop_sec * rate))
    if len(samples) <= win:
        return [math.sqrt(sum(v * v for v in samples) / len(samples))]
    return [
        math.sqrt(sum(v * v for v in samples[s : s + win]) / win)
        for s in range(0, len(samples) - win + 1, hop)
    ]


def loud_and_floor_db(samples, rate):
    loud = sorted(window_rms_profile(samples, rate))[-1]
    quiet = sorted(window_rms_profile(samples, rate, FLOOR_WIN_SEC, FLOOR_HOP_SEC))
    floor = quiet[min(len(quiet) - 1, int(len(quiet) * FLOOR_PERCENTILE))]
    return db(loud), db(floor)


def main():
    if len(sys.argv) < 3:
        print(json.dumps({"ok": False, "error": "usage: voice-audio-prep <in> <out.wav>"}))
        return 2

    src, dst = Path(sys.argv[1]), Path(sys.argv[2])
    samples, rate, channel = load(src)
    if not samples or not rate:
        print(json.dumps({"ok": False, "error": "unreadable audio"}))
        return 1

    clipped_before = sum(1 for v in samples if abs(v) >= RAIL) / len(samples)
    samples, trimmed = trim_wakeup_pop(samples, rate)
    if not samples:
        print(json.dumps({"ok": False, "error": "empty after trim"}))
        return 1

    peak = max(abs(v) for v in samples)
    rms = math.sqrt(sum(v * v for v in samples) / len(samples))
    peak_db, rms_db = db(peak), db(rms)
    loud_rms_db, floor_rms_db = loud_and_floor_db(samples, rate)
    snr_db = loud_rms_db - floor_rms_db

    duration = len(samples) / rate
    clipped_pct = clipped_before * 100
    audible = snr_db >= MIN_SNR_DB or loud_rms_db >= LOUD_ENOUGH_DB

    if duration < MIN_DUR:
        verdict = "short"
    elif clipped_pct > MAX_CLIP_PCT:
        verdict = "clipped"
    elif peak_db < MIN_PEAK_DB or not audible:
        verdict = "silence"
    else:
        verdict = "speech"

    gain_db = min(TARGET_RMS_DB - rms_db, PEAK_CEILING_DB - peak_db, MAX_GAIN_DB)
    factor = 10 ** (gain_db / 20.0)
    scaled = [max(-32768, min(32767, int(round(v * factor)))) for v in samples]

    with wave.open(str(dst), "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(rate)
        w.writeframes(struct.pack("<%dh" % len(scaled), *scaled))

    print(json.dumps({
        "ok": True,
        "verdict": verdict,
        "channel": channel,
        "duration": round(duration, 3),
        "trimmed_ms": round(trimmed * 1000 / rate, 1),
        "peak_db": round(peak_db, 1),
        "rms_db": round(rms_db, 1),
        "loud_rms_db": round(loud_rms_db, 1),
        "floor_rms_db": round(floor_rms_db, 1),
        "snr_db": round(snr_db, 1),
        "gain_db": round(gain_db, 1),
        "clipped_pct": round(clipped_pct, 1),
    }))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
