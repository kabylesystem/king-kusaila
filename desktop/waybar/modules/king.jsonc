// Modules Waybar custom de naly — King Kusaila + bouton DND.
// Posé hors de config.jsonc (régénéré par HyDE) : toujours chargé via l'include
// "modules/*json*", donc les DÉFINITIONS survivent aux régénérations/switch de thème.
// Les NOMS de ces modules sont (re)mis dans la barre par ~/.local/bin/naly-desktop-restore
// (déclenché par le watcher systemd naly-desktop-restore.path après chaque régén HyDE).
{
    "network": {
        "tooltip": true,
        "format-wifi": "\uf1eb ",
        "rotate": 0,
        "format-ethernet": "\udb80\ude00 ",
        "tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal: <b>{signalStrength}%</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}</b>",
        "format-linked": "\udb80\ude00 {ifname}",
        "format-disconnected": "\udb81\uddaa ",
        "tooltip-format-disconnected": "Offline",
        "interval": 5,
        "on-click": "$HOME/.local/bin/naly-control wifi",
        "on-click-right": "$HOME/.local/bin/naly-control wifi"
    },
    "bluetooth": {
        "format": "\udb80\udcaf",
        "rotate": 0,
        "format-disabled": "\udb80\udcb2",
        "format-connected": "\udb80\udcb1",
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage} %",
        "on-click": "$HOME/.local/bin/naly-control bt"
    },
    "clock": {
        "format": "{:%a %d · %I:%M %p}",
        "rotate": 0,
        "format-alt": "{:%R 󰃭 %d·%m·%y}",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/naly-calendar"
    },
    "custom/claude": {
        "exec": "$HOME/.local/bin/waybar-claude.sh",
        "return-type": "json",
        "interval": 20,
        "tooltip": true,
        "on-click": "kitty --title 'Claude Launcher' -e $HOME/.local/bin/claude-here.sh"
    },
    "custom/king-voice": {
        "exec": "$HOME/.local/bin/waybar-king-voice.sh",
        "return-type": "json",
        "interval": 8,
        "signal": 8,
        "tooltip": true,
        "on-click": "kitty --hold --title 'King Kusaila' -e $HOME/.local/bin/king-kusaila-status"
    },
    "image#king": {
        "exec": "$HOME/.local/bin/waybar-king-icon.sh",
        "size": 24,
        "interval": 10,
        "signal": 9,
        "on-click": "$HOME/.local/bin/king-repondeur toggle && sleep 0.2 && pkill -RTMIN+9 waybar",
        "on-click-right": "kitty --hold --title 'King Kusaila' -e $HOME/.local/bin/king-kusaila-status",
        "tooltip": true
    },
    "custom/antibug": {
    "exec": "$HOME/.local/bin/waybar-antibug.sh",
    "return-type": "json",
    "interval": 5,
    "tooltip": true,
    "on-click": "$HOME/.local/bin/naly-antibug",
    "on-click-right": "kitty --title antibug-history -e sh -c '$HOME/.local/bin/pc-furie 12; echo; read -p \"entree pour fermer\"'"
  },

  "custom/thermal": {
        "exec": "$HOME/.local/bin/waybar-thermal.sh",
        "return-type": "json",
        "interval": 5,
        "tooltip": true,
        "on-click": "/usr/local/bin/naly-thermal-profile cycle",
        "on-click-right": "/usr/local/bin/naly-thermal-profile silencieux"
    },
    "custom/dnd": {
        "exec": "$HOME/.local/bin/naly-dnd icon",
        "interval": 10,
        "signal": 10,
        "tooltip": true,
        "tooltip-format": "Notifications — clic gauche : bascule Do Not Disturb · clic droit : réactiver · clic milieu : couper. Seules les alertes critiques passent.",
        "on-click": "$HOME/.local/bin/naly-dnd toggle && pkill -RTMIN+10 waybar",
        "on-click-right": "$HOME/.local/bin/naly-dnd off",
        "on-click-middle": "$HOME/.local/bin/naly-dnd on"
    },
    "custom/ios": {
        "exec": "$HOME/.local/bin/ios-status --waybar",
        "return-type": "json",
        "interval": 120,
        "signal": 10,
        "tooltip": true,
        "on-click": "/home/kusaila/.local/bin/ios-resign-window",
        "on-click-right": "/home/kusaila/.local/bin/ios-status-window"
    }
}
