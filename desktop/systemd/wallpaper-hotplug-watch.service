[Unit]
Description=Repeint le wallpaper quand un écran est branché à chaud (awww rate les nouveaux outputs)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/wallpaper-hotplug-watch
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
